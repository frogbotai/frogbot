# FrogBot live test suite. Copy to .env.live.local (gitignored) and fill in.
# Every key here is used by `pnpm test:live`; bump and release run it with LIVE_STRICT=1,
# so a missing key fails the run instead of skipping.

# ── AI router: direct providers ─────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=.live-credentials/vertex-service-account.json
# Bedrock: set ONE of these (checked in this order).
#  1. Bedrock API key — long-term keys can be created with no expiry (Bedrock console → API keys).
AWS_BEARER_TOKEN_BEDROCK=
#  2. SSO profile — uses your local `aws sso login` session (expires; re-login when it does).
AWS_PROFILE=
#  3. IAM access keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AZURE_API_KEY=
AZURE_RESOURCE_NAME=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=

# ── AI router: embeddings, rerank, media ────────────────────────────────────
COHERE_API_KEY=
VOYAGE_API_KEY=
REPLICATE_API_TOKEN=
FAL_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# ── Search pieces ───────────────────────────────────────────────────────────
BRAVE_API_KEY=
EXA_API_KEY=

# ── Slack (test workspace "frogbot-live") ───────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=
SLACK_TEAM_ID=
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TEST_CHANNEL_ID=

# ── GitHub (org "frogbot-live", repo "sandbox") ─────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=.live-credentials/github-app.pem
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_TEST_REPO=frogbot-live/sandbox

# ── Google (Gmail, Drive, Sheets, Calendar; one test account) ──────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_TEST_EMAIL=
GOOGLE_TEST_DRIVE_FOLDER_ID=
GOOGLE_TEST_SHEET_ID=
GOOGLE_TEST_CALENDAR_ID=

# ── Notion ──────────────────────────────────────────────────────────────────
NOTION_TOKEN=
NOTION_TEST_PAGE_ID=
NOTION_TEST_DATABASE_ID=

# ── Linear ──────────────────────────────────────────────────────────────────
LINEAR_API_KEY=
LINEAR_TEST_TEAM_ID=
LINEAR_WEBHOOK_SECRET=

# ── Stripe (test mode only: sk_test_...) ────────────────────────────────────
STRIPE_TEST_SECRET_KEY=

# ── Airtable ────────────────────────────────────────────────────────────────
AIRTABLE_TOKEN=
AIRTABLE_TEST_BASE_ID=

# ── Resend ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=
RESEND_TEST_TO=

# ── Telegram / Discord (channels phase) ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_TEST_CHANNEL_ID=

# ── Tunnel (channels phase) ─────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=
LIVE_PUBLIC_URL=

# --- RAG hosted smoke checks (optional; skipped when unset) ---
# Use a throwaway Neon branch; the test creates and drops its own schema.
NEON_DATABASE_URL=
# Atlas cluster URI (M0 free tier is fine); the test creates and drops its own database.
ATLAS_URI=

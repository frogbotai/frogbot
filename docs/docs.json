  "redirects": [
    { "source": "/configuration/admin-navigation", "destination": "/admin/admin-navigation" },
    { "source": "/configuration/collection-board", "destination": "/admin/collection-board" },
    { "source": "/configuration/collection-calendar", "destination": "/admin/collection-calendar" },
    { "source": "/configuration/jobs", "destination": "/jobs-queue/overview" },
    { "source": "/deployment/jobs", "destination": "/jobs-queue/workers" },
    { "source": "/configuration/files", "destination": "/upload/files" },
    { "source": "/configuration/ai", "destination": "/ai/overview" },
    { "source": "/configuration/agents", "destination": "/agents/overview" },
    { "source": "/configuration/mcp", "destination": "/mcp/overview" },
    { "source": "/configuration/web-search", "destination": "/pieces/web-search" },
    { "source": "/configuration/connections", "destination": "/connections/overview" },
    { "source": "/configuration/pieces", "destination": "/pieces/overview" },
    { "source": "/access-control/globals", "destination": "/access-control/collections" },
    { "source": "/hooks/globals", "destination": "/hooks/collections" }
  ],
  "background": {
    "color": {
      "dark": "#101828",
      "light": "#F9FAFB"
    }

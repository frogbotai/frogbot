              { "group": "AI", "expanded": false, "pages": ["ai/overview"]},
              { "group": "Agents", "expanded": false, "pages": ["agents/overview"]},
              { "group": "Chat", "expanded": false, "pages": ["chat/overview", "chat/questions", "chat/turns", "chat/manifest", "chat/training-data", "chat/ui-installation", "chat/ui-provider", "chat/ui-chat", "chat/ui-theming", "chat/ui-registries", "chat/ui-custom-shell"]},

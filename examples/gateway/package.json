    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@frogbotai/gateway": "0.8.0",
    "@hono/node-server": "^1.13.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.2.5",
    "tsx": "^4.19.2",
    "typescript": "5.6.2"
  }
}

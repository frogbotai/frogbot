{
  "name": "frogbot-example-gateway",
  "version": "0.8.0",
  "private": true,
  "description": "Gateway example: multiple managed providers plus self-hosted inference behind one OpenAI-compatible gateway, embedded in a tiny Hono server.",
  "license": "MIT",
  "type": "module",
  "scripts": {

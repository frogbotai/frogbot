{
  "name": "acme",
  "version": "0.42.0",
  "description": "A blank template to get started with FrogBot.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "frogbot dev",
    "prebuild": "frogbot generate:importmap",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "frogbot start",
    "generate:types": "frogbot generate:types",
    "generate:importmap": "frogbot generate:importmap",
    "migrate": "frogbot migrate",
    "migrate:create": "frogbot migrate:create",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "seed": "frogbot run src/seed/index.ts"
  },
  "dependencies": {
    "@frogbotai/db-sqlite": "^0.42.0",
    "@frogbotai/next": "^0.42.0",
    "@frogbotai/plugin-ai-policy": "^0.42.0",
    "@frogbotai/plugin-api-keys": "^0.42.0",
    "@frogbotai/plugin-dojo": "^0.42.0",
    "@frogbotai/richtext-lexical": "^0.42.0",
    "@frogbotai/transformer-sharp": "^0.42.0",
    "@frogbotai/ui": "^0.42.0",
    "@libsql/client": "0.14.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.7",
    "drizzle-orm": "0.45.2",
    "frogbot": "^0.42.0",
    "graphql": "^16.8.1",
    "json-schema-to-typescript": "^15.0.3",
    "libsql": "^0.4.7",
    "next": "16.4.2",
    "pino": "^9.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "^3.2.5",
    "typescript": "6.0.3"
  }
}

{
  "name": "frogbot-example-basic-agent",
  "version": "0.33.0",
  "private": true,
  "description": "Minimal FrogBot example: one agent, one tool, SQLite storage, admin panel via Next.js. No Docker required.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "frogbot dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "frogbot start",
    "generate:types": "frogbot generate:types",
    "generate:importmap": "frogbot generate:importmap",
    "migrate": "frogbot migrate",
    "migrate:create": "frogbot migrate:create",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@frogbotai/db-sqlite": "0.33.0",
    "@frogbotai/next": "0.33.0",
    "@frogbotai/ui": "0.33.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.7",
    "frogbot": "0.33.0",
    "graphql": "^16.8.1",
    "json-schema-to-typescript": "^15.0.3",
    "libsql": "^0.4.7",
    "next": "16.4.0",
    "pino": "^9.14.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "^3.2.5",
    "typescript": "6.0.3"
  }
}

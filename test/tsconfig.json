{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "isolatedModules": true
  },
  "exclude": ["node_modules", "dist", ".tmp"],
  "include": ["./**/*.ts", "./**/*.tsx"]
}

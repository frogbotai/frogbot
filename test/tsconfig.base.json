{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@opentelemetry/*": ["../packages/gateway/node_modules/@opentelemetry/*"]
    }
  }
}

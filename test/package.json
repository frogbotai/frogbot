{
  "name": "frogbot-test-suite",
  "version": "0.0.0",
  "private": true,
  "description": "Firmware integration + e2e test suite. Mirrors Payload's `test/` package layout — owns its own `\"type\": \"module\"` so config files load as ESM, owns test-only devDependencies, and exposes thin proxy scripts back to the root.",
  "type": "module",
  "scripts": {
    "test": "pnpm -C \"../\" run test",
    "test:int": "pnpm -C \"../\" run test:int",
    "test:unit": "pnpm -C \"../\" run test:unit",
    "test:e2e": "pnpm -C \"../\" run test:e2e"
  },
  "devDependencies": {
    "@ai-sdk/mcp": "^2.0.3",
    "@frogbotai/db-d1-sqlite": "workspace:*",
    "@frogbotai/db-mongodb": "workspace:*",
    "@frogbotai/db-postgres": "workspace:*",
    "@frogbotai/db-sqlite": "workspace:*",
    "@frogbotai/gateway": "workspace:*",
    "@frogbotai/kv-redis": "workspace:*",
    "@frogbotai/live-preview-react": "workspace:*",
    "@frogbotai/next": "workspace:*",
    "@frogbotai/piece-gmail": "workspace:*",
    "@frogbotai/piece-google": "workspace:*",
    "@frogbotai/richtext-lexical": "workspace:*",
    "@frogbotai/piece-resend": "workspace:*",
    "@frogbotai/plugin-api-keys": "workspace:*",
    "@frogbotai/plugin-audit-log": "workspace:*",
    "@frogbotai/plugin-import-export": "workspace:*",
    "@frogbotai/plugin-mcp": "workspace:*",
    "@frogbotai/plugin-nested-docs": "workspace:*",
    "@frogbotai/plugin-redirects": "workspace:*",
    "@frogbotai/plugin-roles": "workspace:*",
    "@frogbotai/plugin-search": "workspace:*",
    "@frogbotai/plugin-sentry": "workspace:*",
    "@frogbotai/plugin-stripe": "workspace:*",
    "@frogbotai/storage-azure": "workspace:*",
    "@frogbotai/storage-gcs": "workspace:*",
    "@frogbotai/storage-r2": "workspace:*",
    "@frogbotai/storage-s3": "workspace:*",
    "@frogbotai/storage-uploadthing": "workspace:*",
    "@frogbotai/storage-vercel-blob": "workspace:*",
    "@frogbotai/ui": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@payloadcms/drizzle": "3.90.1",
    "@payloadcms/kv-redis": "3.90.1",
    "@types/node": "^22.9.1",

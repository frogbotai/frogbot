{
  "name": "@frogbotai/sdk",
  "version": "0.11.0",
  "description": "Framework-agnostic FrogBot API client.",
  "license": "MIT",
  "author": "Colby Gilbert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frogbotai/frogbot.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/frogbotai/frogbot#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run --root ../.. --project=unit packages/sdk/src/index.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "5.6.2",
    "vitest": "4.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@frogbotai/sdk",
  "version": "0.30.0",
  "description": "Framework-agnostic FrogBot API client.",
  "license": "MIT",
  "author": "Colby Gilbert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frogbotai/frogbot.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/frogbotai/frogbot#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "qs-esm": "8.0.1"
  },
  "peerDependencies": {
    "frogbot": "workspace:*"
  },
  "peerDependenciesMeta": {
    "frogbot": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "clean": "rm -rf dist",
    "test": "vitest run --root ../.. --project=unit test/unit/sdk/index.spec.ts",
    "typecheck": "tsc --noEmit && pnpm typecheck:types",
    "typecheck:types": "tsc --noEmit -p ../../test/types/sdk/tsconfig.generated.json && tsc --noEmit -p ../../test/types/sdk/tsconfig.fallback.json"
  },
  "devDependencies": {
    "frogbot": "workspace:*",
    "typescript": "5.6.2",
    "vitest": "4.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@frogbotai/plugin-audit-log",
  "version": "0.41.0",
  "description": "Immutable collection audit logs for FrogBot.",
  "license": "MIT",
  "author": "Colby Gilbert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frogbotai/frogbot.git",
    "directory": "packages/plugins/plugin-audit-log"
  },
  "homepage": "https://github.com/frogbotai/frogbot#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rsc": {
      "import": "./dist/rsc.js",
      "types": "./dist/rsc.d.ts",
      "default": "./dist/rsc.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node ../../../scripts/build-package.mjs --assets css",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "peerDependencies": {
    "@payloadcms/translations": "catalog:",
    "@frogbotai/ui": "workspace:*",
    "frogbot": "workspace:*",
    "react": "^19.0.1 || ^19.1.2 || ^19.2.1"
  },
  "devDependencies": {
    "@payloadcms/translations": "catalog:",
    "@frogbotai/ui": "workspace:*",
    "@types/react": "19.2.14",
    "frogbot": "workspace:*",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}

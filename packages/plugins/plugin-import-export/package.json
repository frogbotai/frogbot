{
  "name": "@frogbotai/plugin-import-export",
  "version": "0.32.0",
  "description": "Payload import and export integration for FrogBot.",
  "license": "MIT",
  "author": "Colby Gilbert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frogbotai/frogbot.git",
    "directory": "packages/plugins/plugin-import-export"
  },
  "homepage": "https://github.com/frogbotai/frogbot#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rsc": {
      "import": "./dist/rsc.js",
      "types": "./dist/rsc.d.ts",
      "default": "./dist/rsc.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../../scripts/build-package.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@payloadcms/plugin-import-export": "3.90.1"
  },
  "peerDependencies": {
    "frogbot": "workspace:*",
    "payload": "3.90.1",
    "react": "^19.0.1 || ^19.1.2 || ^19.2.1",
    "react-dom": "^19.0.1 || ^19.1.2 || ^19.2.1"
  },
  "devDependencies": {
    "frogbot": "workspace:*",
    "payload": "3.90.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.6.2"
  },
  "publishConfig": {
    "access": "public"
  }
}

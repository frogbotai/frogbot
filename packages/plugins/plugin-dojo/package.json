{
  "name": "@frogbotai/plugin-dojo",
  "version": "0.37.0",
  "description": "File storage and AI for FrogBot apps running on Dojo.",
  "license": "MIT",
  "author": "Colby Gilbert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frogbotai/frogbot.git",
    "directory": "packages/plugins/plugin-dojo"
  },
  "homepage": "https://github.com/frogbotai/frogbot#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "frogbot-dojo": "./bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "bin.js"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node ../../../scripts/build-package.mjs --assets css",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@frogbotai/storage-s3": "workspace:*",
    "@next/env": "catalog:",
    "eventsource-parser": "3.1.0",
    "ignore": "7.0.6",
    "tar": "7.5.22",
    "to-snake-case": "1.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@frogbotai/gateway": "workspace:*",
    "frogbot": "workspace:*",
    "payload": "catalog:",
    "react": "^19.0.1 || ^19.1.2 || ^19.2.1",
    "react-dom": "^19.0.1 || ^19.1.2 || ^19.2.1"
  },
  "devDependencies": {
    "@frogbotai/gateway": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@types/react": "19.2.14",
    "@types/to-snake-case": "1.0.0",
    "frogbot": "workspace:*",
    "payload": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@frogbotai/plugin-two-factor",
  "version": "0.41.0",
  "description": "Two-factor sign-in for FrogBot: authenticator codes and recovery codes after the password or sign-in provider.",
  "license": "MIT",
  "author": "Colby Gilbert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frogbotai/frogbot.git",
    "directory": "packages/plugins/plugin-two-factor"
  },
  "homepage": "https://github.com/frogbotai/frogbot#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./rsc": {
      "import": "./dist/rsc.js",
      "types": "./dist/rsc.d.ts",
      "default": "./dist/rsc.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "build": "node ../../../scripts/build-package.mjs --assets css",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "otpauth": "9.5.2",
    "qrcode": "1.5.4"
  },
  "peerDependencies": {
    "@frogbotai/ui": "workspace:*",
    "frogbot": "workspace:*",
    "payload": "catalog:",
    "react": "^19.0.1 || ^19.1.2 || ^19.2.1",
    "react-dom": "^19.0.1 || ^19.1.2 || ^19.2.1"
  },
  "devDependencies": {
    "@frogbotai/ui": "workspace:*",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.14",
    "frogbot": "workspace:*",
    "payload": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "import": "./dist/client.js",
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "./rsc": {
        "import": "./dist/rsc.js",
        "types": "./dist/rsc.d.ts",
        "default": "./dist/rsc.js"
      }
    }
  }
}

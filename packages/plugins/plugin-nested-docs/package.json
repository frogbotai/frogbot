{
  "name": "@frogbotai/plugin-nested-docs",
  "version": "0.14.0",
  "description": "Payload nested documents integration for FrogBot.",
  "license": "MIT",
  "author": "Colby Gilbert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frogbotai/frogbot.git",
    "directory": "packages/plugins/plugin-nested-docs"
  },
  "homepage": "https://github.com/frogbotai/frogbot#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@payloadcms/plugin-nested-docs": "3.85.1"
  },
  "peerDependencies": {
    "frogbot": "workspace:*",
    "payload": "3.85.1"
  },
  "devDependencies": {
    "frogbot": "workspace:*",
    "payload": "3.85.1",
    "typescript": "5.6.2"
  },
  "publishConfig": {
    "access": "public"
  }
}

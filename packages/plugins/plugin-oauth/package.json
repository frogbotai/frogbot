{
  "name": "@frogbotai/plugin-oauth",
  "version": "0.17.0",
  "description": "OAuth connections for FrogBot.",
  "license": "MIT",
  "author": "Colby Gilbert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frogbotai/frogbot.git",
    "directory": "packages/plugins/plugin-oauth"
  },
  "homepage": "https://github.com/frogbotai/frogbot#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.scss"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm copyfiles",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit && pnpm typecheck:types",
    "typecheck:types": "tsc --noEmit -p tsconfig.typetest.json",
    "copyfiles": "copyfiles -u 1 \"src/**/*.scss\" dist/"
  },
  "peerDependencies": {
    "@frogbotai/ui": "workspace:*",
    "@payloadcms/ui": "3.85.1",
    "frogbot": "workspace:*",
    "payload": "3.85.1",
    "react": "^19.0.1 || ^19.1.2 || ^19.2.1",
    "react-dom": "^19.0.1 || ^19.1.2 || ^19.2.1"
  },
  "devDependencies": {
    "@frogbotai/ui": "workspace:*",
    "@payloadcms/ui": "3.85.1",
    "@types/react": "19.2.14",
    "copyfiles": "^2.4.1",
    "frogbot": "workspace:*",
    "payload": "3.85.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.6.2"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./server": {
        "import": "./dist/server.js",
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "./client": {
        "import": "./dist/client.js",
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      }
    }
  }
}

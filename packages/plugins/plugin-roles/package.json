{
  "name": "@frogbotai/plugin-roles",
  "version": "0.35.0",
  "description": "Code-defined role-based access control for FrogBot.",
  "license": "MIT",
  "author": "Colby Gilbert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frogbotai/frogbot.git",
    "directory": "packages/plugins/plugin-roles"
  },
  "homepage": "https://github.com/frogbotai/frogbot#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../../scripts/build-package.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.typetest.json"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "peerDependencies": {
    "frogbot": "workspace:*",
    "payload": "catalog:"
  },
  "devDependencies": {
    "frogbot": "workspace:*",
    "payload": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}

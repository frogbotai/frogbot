{
  "name": "@frogbotai/ui",
  "version": "0.13.0",
  "description": "React components for FrogBot chat interfaces.",
  "license": "MIT",
  "author": "Colby Gilbert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frogbotai/frogbot.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/frogbotai/frogbot#readme",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./icons": {
      "types": "./src/exports/icons.ts",
      "import": "./src/exports/icons.ts",
      "default": "./src/exports/icons.ts"
    },
    "./icons/*": {
      "types": "./src/icons/*.ts",
      "import": "./src/icons/*.ts",
      "default": "./src/icons/*.ts"
    },
    "./theme": {
      "types": "./src/exports/theme.ts",
      "import": "./src/exports/theme.ts",
      "default": "./src/exports/theme.ts"
    },
    "./chat": {
      "types": "./src/exports/chat.ts",
      "import": "./src/exports/chat.ts",
      "default": "./src/exports/chat.ts"
    },
    "./chat/tools": {
      "types": "./src/exports/chat-tools.ts",
      "import": "./src/exports/chat-tools.ts",
      "default": "./src/exports/chat-tools.ts"
    },
    "./chat/artifacts": {
      "types": "./src/exports/chat-artifacts.ts",
      "import": "./src/exports/chat-artifacts.ts",
      "default": "./src/exports/chat-artifacts.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tailwindcss -i src/styles.css -o dist/styles.css",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "ai": "^7.0.4",
    "frogbot": "0.13.0",
    "react": "^19.0.1 || ^19.1.2 || ^19.2.1",
    "react-dom": "^19.0.1 || ^19.1.2 || ^19.2.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "ai": "^7.0.4",
    "eslint": "^9.16.0",
    "frogbot": "workspace:*",
    "jsdom": "^24.1.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "^4.1.0",
    "typescript": "5.6.2"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./icons": {
        "types": "./dist/exports/icons.d.ts",
        "import": "./dist/exports/icons.js",
        "default": "./dist/exports/icons.js"
      },
      "./icons/*": {
        "types": "./dist/icons/*.d.ts",
        "import": "./dist/icons/*.js",
        "default": "./dist/icons/*.js"
      },
      "./theme": {
        "types": "./dist/exports/theme.d.ts",
        "import": "./dist/exports/theme.js",
        "default": "./dist/exports/theme.js"
      },
      "./chat": {
        "types": "./dist/exports/chat.d.ts",
        "import": "./dist/exports/chat.js",
        "default": "./dist/exports/chat.js"
      },
      "./chat/tools": {
        "types": "./dist/exports/chat-tools.d.ts",
        "import": "./dist/exports/chat-tools.js",
        "default": "./dist/exports/chat-tools.js"
      },
      "./chat/artifacts": {
        "types": "./dist/exports/chat-artifacts.d.ts",
        "import": "./dist/exports/chat-artifacts.js",
        "default": "./dist/exports/chat-artifacts.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.5",
    "@frogbotai/sdk": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.6.0"
  }
}

{
  "name": "@frogbotai/ui",
  "version": "0.33.0",
  "description": "React components for FrogBot chat interfaces.",
  "license": "MIT",
  "author": "Colby Gilbert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frogbotai/frogbot.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/frogbotai/frogbot#readme",
  "type": "module",

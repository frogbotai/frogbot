  "scripts": {
    "build": "node ../../scripts/build-package.mjs --assets css",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ../../test/types/ui/tsconfig.json"
  },
  "peerDependencies": {
    "@payloadcms/translations": "3.90.1",

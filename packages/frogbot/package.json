{
  "name": "frogbot",
  "version": "0.11.0",
  "description": "FrogBot core: typed configuration surface that wraps Payload.",
  "license": "MIT",
  "author": "Colby Gilbert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frogbotai/frogbot.git",
    "directory": "packages/frogbot"
  },
  "homepage": "https://github.com/frogbotai/frogbot#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/exports/test.d.ts",
      "import": "./dist/exports/test.js",
      "default": "./dist/exports/test.js"
    },
    "./pieces": {
      "types": "./dist/exports/pieces.d.ts",
      "import": "./dist/exports/pieces.js",
      "default": "./dist/exports/pieces.js"
    },
    "./pieces/test": {
      "types": "./dist/exports/pieces-test.d.ts",
      "import": "./dist/exports/pieces-test.js",
      "default": "./dist/exports/pieces-test.js"
    },
    "./connections": {
      "types": "./dist/exports/connections.d.ts",
      "import": "./dist/exports/connections.js",
      "default": "./dist/exports/connections.js"
    },
    "./tools": {
      "types": "./dist/exports/tools.d.ts",
      "import": "./dist/exports/tools.js",
      "default": "./dist/exports/tools.js"
    }
  },
  "bin": {
    "frogbot": "./bin.js"
  },
  "files": [
    "dist",
    "bin.js"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x bin.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit && pnpm typecheck:types",
    "typecheck:types": "tsc --noEmit -p tsconfig.typetest.json"
  },
  "dependencies": {
    "@frogbotai/gateway": "workspace:*",
    "@next/env": "15.4.10",
    "@payloadcms/translations": "3.85.1",
    "ai": "^7.0.4",
    "croner": "10.0.1",
    "json-schema-to-typescript": "^15.0.3",
    "payload": "3.85.1",
    "prettier": "^3.2.5",
    "tsx": "^4.19.2",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@ai-sdk/otel": "^1.0.31",
    "next": "^15.4.10"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/otel": {
      "optional": true
    }
  },
  "devDependencies": {
    "@activepieces/piece-text-helper": "0.4.15",
    "@types/node": "^22.10.2",
    "eslint": "^9.16.0",
    "next": "15.4.10",
    "pino": "^9.14.0",
    "typescript": "5.6.2",
    "vitest": "4.1.2"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./test": {
        "types": "./dist/exports/test.d.ts",
        "import": "./dist/exports/test.js",
        "default": "./dist/exports/test.js"
      },
      "./pieces": {
        "types": "./dist/exports/pieces.d.ts",
        "import": "./dist/exports/pieces.js",
        "default": "./dist/exports/pieces.js"
      },
      "./pieces/test": {
        "types": "./dist/exports/pieces-test.d.ts",
        "import": "./dist/exports/pieces-test.js",
        "default": "./dist/exports/pieces-test.js"
      },
      "./connections": {
        "types": "./dist/exports/connections.d.ts",
        "import": "./dist/exports/connections.js",
        "default": "./dist/exports/connections.js"
      },
      "./tools": {
        "types": "./dist/exports/tools.d.ts",
        "import": "./dist/exports/tools.js",
        "default": "./dist/exports/tools.js"
      }
    }
  }
}

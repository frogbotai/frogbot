{
  "name": "@frogbotai/piece-resend",
  "version": "0.23.0",
  "description": "Resend tools for FrogBot.",
  "license": "MIT",
  "author": "Colby Gilbert",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frogbotai/frogbot.git",
    "directory": "packages/pieces/piece-resend"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "generate:types": "frogbot generate:piece-types src/index.ts --export createResend --output src/piece-types.ts",
    "check:types": "pnpm generate:types --check",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "pnpm check:types && tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "frogbot": "workspace:*"
  },
  "devDependencies": {
    "frogbot": "workspace:*",
    "typescript": "5.6.2"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}

{
  "name": "frogbot-monorepo",
  "private": true,
  "version": "0.31.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings=0 --cache --cache-location .idea/tmp/.eslintcache",
    "lint:fix": "eslint . --fix --max-warnings=0 --cache --cache-location .idea/tmp/.eslintcache",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "prettier:write": "prettier --write .",
    "prettier": "prettier --check .",
    "check": "node scripts/check.mjs",
    "ticket": "node scripts/ticket.mjs",
    "typecheck": "pnpm --filter \"./packages/**\" build && pnpm -r --no-bail typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project gateway-unit",
    "test:ui": "vitest run --project ui",
    "test:browser": "playwright test --config test/browser/playwright.config.ts",
    "test:int": "vitest run --project int",
    "test:int:mongo": "FROGBOT_DATABASE=mongodb vitest run --project int",
    "test:int:pg": "FROGBOT_DATABASE=postgres vitest run --project int",
    "test:int:sqlite": "FROGBOT_DATABASE=sqlite vitest run --project int",
    "test:gateway": "vitest run --project gateway-integration",
    "test:e2e": "RUN_E2E=1 vitest run --project e2e",
    "test:live": "RUN_E2E=1 vitest run --project gateway-e2e --project gateway-zen --project live",
    "generate:types": "node test/generateTypes.ts",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "docker:start": "docker compose -f test/docker-compose.yml --profile postgres --profile redis --profile mongodb --profile mongodb-search --profile storage up -d --wait --wait-timeout 120",
    "docker:clean": "docker compose -f test/docker-compose.yml down -v --remove-orphans",
    "bump": "node scripts/prerelease.mjs",
    "release": "node scripts/release.mjs",
    "release:status": "node scripts/release-status.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored --cache --cache-location .idea/tmp/.eslintcache",
      "oxlint --no-error-on-unmatched-pattern",
      "prettier --write"
    ],
    "*.{md,mdx,json,yml,css}": "prettier --write"
  },
  "devDependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.97",
    "@ai-sdk/anthropic": "^4.0.65",
    "@ai-sdk/anthropic-aws": "^2.0.57",
    "@ai-sdk/google": "^4.0.82",
    "@ai-sdk/google-vertex": "^5.0.95",
    "@ai-sdk/openai": "^4.0.78",
    "@ai-sdk/provider": "4.0.18",
    "@ai-sdk/typesafe-ai": "3.0.8",
    "@basetenlabs/performance-client": "^0.0.10",
    "@eslint/js": "^9.16.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@swc/core": "1.15.3",
    "@types/node": "^22.10.2",
    "@vitest/eslint-plugin": "^1.1.0",
    "ai": "7.0.116",
    "eslint": "^9.16.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.8.0",
    "husky": "9.0.11",
    "json-schema-to-typescript": "^15.0.3",
    "libsql": "^0.4.7",
    "lint-staged": "15.2.7",
    "miniflare": "^4.20260730.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "pino": "^9.14.0",
    "prettier": "^3.2.5",
    "typescript": "5.6.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "4.1.2"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ],
    "overrides": {
      "zod": "^4.3.6"
    }
  }
}

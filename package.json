{
  "name": "frogbot-monorepo",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint . --cache --cache-location .idea/tmp/.eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location .idea/tmp/.eslintcache",
    "typecheck": "pnpm --filter \"./packages/**\" build && pnpm -r --no-bail typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest run --project ui",
    "test:ui:acceptance": "pnpm check:ui-architecture && pnpm test:ui && pnpm test:ui:package && pnpm test:ui:next",
    "test:ui:next": "node scripts/test-ui-next.mjs",
    "test:ui:package": "node scripts/test-ui-package.mjs",
    "test:int": "vitest run --project int",
    "test:int:mongo": "FROGBOT_DATABASE=mongodb vitest run --project int",
    "test:int:pg": "FROGBOT_DATABASE=postgres vitest run --project int",
    "test:int:sqlite": "FROGBOT_DATABASE=sqlite vitest run --project int",
    "test:int:db:mongo": "FROGBOT_DATABASE=mongodb vitest run --project int test/database/int.spec.ts",
    "test:int:db:pg": "FROGBOT_DATABASE=postgres vitest run --project int test/database/int.spec.ts",
    "test:int:db:sqlite": "FROGBOT_DATABASE=sqlite vitest run --project int test/database/int.spec.ts",
    "test:int:services": "FROGBOT_DATABASE=sqlite vitest run --project int test/kv/int.spec.ts test/storage/int.spec.ts test/storage-s3/int.spec.ts test/storage-gcs/int.spec.ts test/storage-azure/int.spec.ts test/storage-vercel-blob/int.spec.ts",
    "test:e2e": "RUN_E2E=1 vitest run --project e2e --project gateway-e2e",
    "generate:ai-types": "node scripts/generate-ai-types.mjs",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "check:branding": "node scripts/check-branding.mjs",
    "check:docs-fences": "node scripts/check-docs-fences.mjs",
    "check:ui-architecture": "node scripts/check-ui-architecture.mjs",
    "docker:start": "docker compose -f test/docker-compose.yml --profile",
    "docker:clean": "docker compose -f test/docker-compose.yml down -v --remove-orphans",
    "bump": "pnpm test && pnpm build && node scripts/bump.mjs",
    "publish-packages": "pnpm -r publish --access public --no-git-checks",
    "release": "pnpm test && pnpm build && pnpm publish-packages"
  },
  "devDependencies": {
    "@basetenlabs/performance-client": "^0.0.10",
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.2",
    "@vitest/eslint-plugin": "^1.1.0",
    "eslint": "^9.16.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.8.0",
    "json-schema-to-typescript": "^15.0.3",
    "libsql": "^0.4.7",
    "prettier": "^3.2.5",
    "typescript": "5.6.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "4.1.2"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ],
    "overrides": {
      "zod": "^4.3.6"
    }
  }
}
